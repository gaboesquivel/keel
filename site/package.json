{
  "name": "keel-site",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "keel website: the six independent skills, rendered from skills/<name>/SKILL.md at build time",
  "scripts": {
    "content": "node scripts/build-content.mjs",
    "dev": "node scripts/build-content.mjs --watch & next dev",
    "prebuild": "pnpm content",
    "build": "next build",
    "start": "next start",
    "lint": "oxlint .",
    "check-types": "pnpm content && tsc --noEmit",
    "test": "vitest run",
    "qa": "pnpm lint && pnpm check-types && pnpm test"
  },
  "dependencies": {
    "ai": "7.0.150",
    "lucide-react": "^1.61.0",
    "next": "16.4.6",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "marked": "^16.4.1",
    "oxlint": "^1.89.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "vitest": "4.1.11",
    "yaml": "^2.9.1"
  },
  "engines": {
    "node": "24.x"
  },
  "packageManager": "pnpm@11.25.0"
}
